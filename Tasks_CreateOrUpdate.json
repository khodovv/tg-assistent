{
  "name": "Tasks_CreateOrUpdate",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const t = $json.task || {};\nconst tz = $env.DEFAULT_TIMEZONE || 'Europe/Amsterdam';\nconst now = DateTime.now().setZone(tz);\nconst remindPolicy = Array.isArray(t.remind_policy_minutes) && t.remind_policy_minutes.length ? t.remind_policy_minutes : [60,15];\nconst due = t.due_at_iso ? DateTime.fromISO(t.due_at_iso).setZone(tz) : now.plus({hours:2});\nlet next = due.minus({minutes: remindPolicy[0]});\nconst qStart = Number($env.QUIET_HOURS_START || 23);\nconst qEnd = Number($env.QUIET_HOURS_END || 8);\nif (next.hour >= qStart || next.hour < qEnd) next = next.set({hour:qEnd, minute:0, second:0, millisecond:0});\nconst taskId = t.task_id || crypto.randomUUID();\nconst dedupe = `task:${$json.user_id}:${(t.title||'').toLowerCase().trim()}:${due.toISODate()}`;\nreturn [{...$json, task_id:taskId, due_at_iso:due.toISO(), next_remind_at_iso:next.toISO(), remind_policy_minutes_json:JSON.stringify(remindPolicy), dedupe_key:dedupe, status:t.status || 'open', priority:t.priority || 'normal', title:t.title || 'Новая задача', details:t.details || ''}];"
      },
      "id": "prep",
      "name": "Prepare Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 140]
    },
    {
      "parameters": { "operation": "appendOrUpdate", "documentId": "={{$env.SPREADSHEET_ID}}", "sheetName": "Tasks", "columns": { "matchingColumns": ["dedupe_key"], "mappingMode": "defineBelow", "value": { "task_id": "={{$json.task_id}}", "created_at_iso": "={{$now.toISO()}}", "updated_at_iso": "={{$now.toISO()}}", "user_id": "={{$json.user_id}}", "username": "={{$json.username}}", "title": "={{$json.title}}", "details": "={{$json.details}}", "status": "={{$json.status}}", "priority": "={{$json.priority}}", "due_at_iso": "={{$json.due_at_iso}}", "timezone": "={{$env.DEFAULT_TIMEZONE || 'Europe/Amsterdam'}}", "remind_policy_minutes": "={{$json.remind_policy_minutes_json}}", "next_remind_at_iso": "={{$json.next_remind_at_iso}}", "last_reminded_at_iso": "", "calendar_event_id": "={{$json.calendar_event_id || ''}}", "calendar_sync_token": "", "source": "telegram", "dedupe_key": "={{$json.dedupe_key}}", "tg_chat_id": "={{$json.tg_chat_id}}", "tg_message_id": "={{$json.tg_message_id}}", "snooze_until_iso": "", "done_at_iso": "", "canceled_at_iso": "" } } },
      "id": "upsert_task",
      "name": "Upsert Task",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [-420, 140],
      "credentials": { "googleSheetsOAuth2Api": { "id": "={{$env.GOOGLE_CREDENTIAL_ID}}", "name": "Google" } }
    },
    {
      "parameters": { "conditions": { "conditions": [{ "leftValue": "={{$json.task.calendar_create}}", "rightValue": true, "operator": { "operation": "equals" } }] } },
      "id": "if_calendar",
      "name": "If Calendar Create",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-180, 140]
    },
    {
      "parameters": { "operation": "create", "calendar": "={{$env.CALENDAR_ID}}", "start": "={{$json.due_at_iso}}", "end": "={{DateTime.fromISO($json.due_at_iso).plus({minutes:($json.task.duration_min || 60)}).toISO()}}", "additionalFields": { "summary": "={{$json.title}}", "description": "={{'task_id=' + $json.task_id}}", "location": "={{$json.task.location || ''}}" } },
      "id": "gcal",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [40, 60],
      "credentials": { "googleCalendarOAuth2Api": { "id": "={{$env.GOOGLE_CREDENTIAL_ID}}", "name": "Google" } }
    },
    {
      "parameters": { "chatId": "={{$json.tg_chat_id}}", "text": "=✅ Задача сохранена: {{$json.title}}\n🔔 Следующее напоминание: {{DateTime.fromISO($json.next_remind_at_iso).setZone($env.DEFAULT_TIMEZONE || 'Europe/Amsterdam').toFormat('dd LLL HH:mm')}}" },
      "id": "ok",
      "name": "Telegram Confirm",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [260, 140],
      "credentials": { "telegramApi": { "id": "={{$env.TELEGRAM_BOT_CREDENTIAL_ID}}", "name": "Telegram Bot" } }
    },
    {
      "parameters": { "operation": "append", "documentId": "={{$env.SPREADSHEET_ID}}", "sheetName": "Logs", "columns": { "mappingMode": "defineBelow", "value": { "log_id": "={{crypto.randomUUID()}}", "ts_iso": "={{$now.toISO()}}", "level": "info", "workflow": "Tasks_CreateOrUpdate", "user_id": "={{$json.user_id}}", "username": "={{$json.username}}", "action": "upsert_task", "intent": "task_create_or_update", "source": "telegram", "input_text": "={{$json.text_in}}", "payload_json": "={{JSON.stringify($json)}}", "error": "" } } },
      "id": "log",
      "name": "Log Task",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 140],
      "credentials": { "googleSheetsOAuth2Api": { "id": "={{$env.GOOGLE_CREDENTIAL_ID}}", "name": "Google" } }
    }
  ],
  "connections": {
    "Prepare Task": { "main": [[{ "node": "Upsert Task", "type": "main", "index": 0 }]] },
    "Upsert Task": { "main": [[{ "node": "If Calendar Create", "type": "main", "index": 0 }]] },
    "If Calendar Create": { "main": [[{ "node": "Create Calendar Event", "type": "main", "index": 0 }], [{ "node": "Telegram Confirm", "type": "main", "index": 0 }]] },
    "Create Calendar Event": { "main": [[{ "node": "Telegram Confirm", "type": "main", "index": 0 }]] },
    "Telegram Confirm": { "main": [[{ "node": "Log Task", "type": "main", "index": 0 }]] }
  },
  "settings": { "timezone": "Europe/Amsterdam" },
  "active": false,
  "id": "Tasks_CreateOrUpdate"
}
