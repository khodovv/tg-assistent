    {
      "parameters": {
        "jsCode": "const upd = $json;\nconst msg = upd.message || {};\nconst cb = upd.callback_query || {};\nconst isCallback = !!upd.callback_query;\nconst text = msg.text || cb.data || '';\nconst isVoice = !!msg.voice;\nreturn [{\n  update_id: upd.update_id,\n  is_callback: isCallback,\n  callback_data: cb.data || null,\n  callback_query_id: cb.id || null,\n  text_in: text,\n  voice_file_id: isVoice ? msg.voice.file_id : null,\n  source_type: isVoice ? 'voice' : 'text',\n  tg_chat_id: msg.chat?.id || cb.message?.chat?.id || null,\n  tg_message_id: msg.message_id || cb.message?.message_id || null,\n  user_id: msg.from?.id || cb.from?.id || null,\n  username: msg.from?.username || cb.from?.username || ''\n}];"
      },
